graph TB
    subgraph "Cliente / Presentation Layer"
        Client[fa:fa-laptop Cliente<br/>Postman / HTTP Client]
    end

    subgraph "API Gateway Layer"
        LB[fa:fa-network-wired Load Balancer<br/>Nginx/HAProxy]
        API1[fa:fa-server API Flask 1]
        API2[fa:fa-server API Flask 2]
        API3[fa:fa-server API Flask 3]

        LB --> API1
        LB --> API2
        LB --> API3
    end

    subgraph "Middleware Layer"
        Auth[fa:fa-shield-alt JWT Auth<br/>Middleware]
        RateLimit[fa:fa-tachometer-alt Rate Limiter<br/>60/min 1000/hr]
        CORS[fa:fa-globe CORS<br/>Handler]
        Validator[fa:fa-check-circle Request<br/>Validator]
    end

    subgraph "Service Layer"
        AuthSvc[fa:fa-key Auth Service<br/>Register/Login/Token]
        SentimentSvc[fa:fa-brain Sentiment<br/>Analyzer]
        CacheSvc[fa:fa-memory Cache Service<br/>In-Memory/Redis]
        QueueSvc[fa:fa-list Queue Manager<br/>Priority Queue]
        WebhookSvc[fa:fa-bell Webhook Service<br/>HTTP Notifications]
        MetricsSvc[fa:fa-chart-line Metrics Service<br/>Analytics]
    end

    subgraph "Worker Layer"
        Worker1[fa:fa-cog Worker 1<br/>Sentiment Processing]
        Worker2[fa:fa-cog Worker 2<br/>Sentiment Processing]
        Worker3[fa:fa-cog Worker 3<br/>Sentiment Processing]
    end

    subgraph "Data Layer"
        DB[(fa:fa-database SQLite/PostgreSQL<br/>Primary DB)]
        CacheStore[(fa:fa-hdd Redis Cache<br/>Distributed)]
        QueueStore[(fa:fa-folder RabbitMQ/Queue<br/>Message Broker)]
    end

    subgraph "External Integrations"
        Webhook1[fa:fa-webhook Webhook 1<br/>External System]
        Webhook2[fa:fa-webhook Webhook 2<br/>External System]
        Monitoring[fa:fa-chart-bar Monitoring<br/>Prometheus/Grafana]
    end

    Client -->|HTTPS| LB

    API1 --> Auth
    API1 --> RateLimit
    API1 --> CORS
    API1 --> Validator

    Auth --> AuthSvc
    RateLimit --> CacheSvc

    AuthSvc --> DB

    API1 -->|Submit Analysis| QueueSvc
    API1 -->|Check Cache| CacheSvc
    API1 -->|Get Metrics| MetricsSvc

    QueueSvc --> QueueStore
    CacheSvc --> CacheStore

    Worker1 -->|Poll Queue| QueueStore
    Worker2 -->|Poll Queue| QueueStore
    Worker3 -->|Poll Queue| QueueStore

    Worker1 --> SentimentSvc
    Worker1 --> DB
    Worker1 --> CacheSvc
    Worker1 --> WebhookSvc

    SentimentSvc -->|NLP Processing| Worker1

    WebhookSvc -->|POST| Webhook1
    WebhookSvc -->|POST| Webhook2

    MetricsSvc --> DB

    API1 -.->|Metrics| Monitoring
    Worker1 -.->|Metrics| Monitoring

    style Client fill:#FF9900,stroke:#232F3E,stroke-width:3px,color:#fff
    style LB fill:#FF9900,stroke:#232F3E,stroke-width:2px,color:#fff
    style API1 fill:#3B48CC,stroke:#232F3E,stroke-width:2px,color:#fff
    style API2 fill:#3B48CC,stroke:#232F3E,stroke-width:2px,color:#fff
    style API3 fill:#3B48CC,stroke:#232F3E,stroke-width:2px,color:#fff

    style Auth fill:#DD344C,stroke:#232F3E,stroke-width:2px,color:#fff
    style RateLimit fill:#DD344C,stroke:#232F3E,stroke-width:2px,color:#fff
    style CORS fill:#DD344C,stroke:#232F3E,stroke-width:2px,color:#fff
    style Validator fill:#DD344C,stroke:#232F3E,stroke-width:2px,color:#fff

    style AuthSvc fill:#5294CF,stroke:#232F3E,stroke-width:2px,color:#fff
    style SentimentSvc fill:#5294CF,stroke:#232F3E,stroke-width:2px,color:#fff
    style CacheSvc fill:#5294CF,stroke:#232F3E,stroke-width:2px,color:#fff
    style QueueSvc fill:#5294CF,stroke:#232F3E,stroke-width:2px,color:#fff
    style WebhookSvc fill:#5294CF,stroke:#232F3E,stroke-width:2px,color:#fff
    style MetricsSvc fill:#5294CF,stroke:#232F3E,stroke-width:2px,color:#fff

    style Worker1 fill:#759C3E,stroke:#232F3E,stroke-width:2px,color:#fff
    style Worker2 fill:#759C3E,stroke:#232F3E,stroke-width:2px,color:#fff
    style Worker3 fill:#759C3E,stroke:#232F3E,stroke-width:2px,color:#fff

    style DB fill:#3334B9,stroke:#232F3E,stroke-width:2px,color:#fff
    style CacheStore fill:#3334B9,stroke:#232F3E,stroke-width:2px,color:#fff
    style QueueStore fill:#3334B9,stroke:#232F3E,stroke-width:2px,color:#fff

    style Webhook1 fill:#FF9900,stroke:#232F3E,stroke-width:2px,color:#fff
    style Webhook2 fill:#FF9900,stroke:#232F3E,stroke-width:2px,color:#fff
    style Monitoring fill:#FF9900,stroke:#232F3E,stroke-width:2px,color:#fff
