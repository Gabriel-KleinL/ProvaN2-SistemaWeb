{
  "database": "sentiment.db",
  "version": "1.0.0",
  "tables": [
    {
      "name": "users",
      "description": "Usuários do sistema",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "constraints": ["PRIMARY KEY", "AUTOINCREMENT"]
        },
        {
          "name": "email",
          "type": "TEXT",
          "constraints": ["NOT NULL", "UNIQUE"]
        },
        {
          "name": "password_hash",
          "type": "TEXT",
          "constraints": ["NOT NULL"]
        },
        {
          "name": "created_at",
          "type": "TIMESTAMP",
          "constraints": ["DEFAULT CURRENT_TIMESTAMP"]
        }
      ]
    },
    {
      "name": "analyses",
      "description": "Análises de sentimento",
      "columns": [
        {
          "name": "id",
          "type": "TEXT",
          "constraints": ["PRIMARY KEY"]
        },
        {
          "name": "user_id",
          "type": "INTEGER",
          "constraints": ["NOT NULL", "FOREIGN KEY REFERENCES users(id)"]
        },
        {
          "name": "text",
          "type": "TEXT",
          "constraints": ["NOT NULL"]
        },
        {
          "name": "sentiment",
          "type": "TEXT",
          "constraints": ["NULL"]
        },
        {
          "name": "score",
          "type": "REAL",
          "constraints": ["NULL"]
        },
        {
          "name": "status",
          "type": "TEXT",
          "constraints": ["DEFAULT 'pending'"]
        },
        {
          "name": "created_at",
          "type": "TIMESTAMP",
          "constraints": ["DEFAULT CURRENT_TIMESTAMP"]
        }
      ]
    }
  ]
}
